# Docling parse worker girdileri; runtime pin'leri requirements.txt ile aynı kalır.
-c requirements.txt
# Modal worker'ı linux/x86_64'tür: PyPI'nin CUDA'lı linux wheel'i yerine hash'li CPU wheel'i.
# Diğer platformlarda (yerel geliştirme) PyPI wheel'i zaten CPU build'idir.
torch @ https://download-r2.pytorch.org/whl/cpu/torch-2.13.0%2Bcpu-cp313-cp313-manylinux_2_28_x86_64.whl#sha256=3fbf9c9d1f3c10c2d59d04aca426dee9ccc6ceb32d255c61e93acc3b4f75fae6 ; sys_platform == 'linux' and platform_machine == 'x86_64'
torch==2.13.0 ; sys_platform != 'linux' or platform_machine != 'x86_64'
torchvision @ https://download-r2.pytorch.org/whl/cpu/torchvision-0.28.0%2Bcpu-cp313-cp313-manylinux_2_28_x86_64.whl#sha256=c6373ec4c2f922e89f45ac91889404d312ba29a31f205b0ad9a725a3894ca246 ; sys_platform == 'linux' and platform_machine == 'x86_64'
torchvision==0.28.0 ; sys_platform != 'linux' or platform_machine != 'x86_64'
