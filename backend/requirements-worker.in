# macOS'ta transformers'ı <5.9 ile sınırladığı için taban yalnız Modal/CI/Windows platformlarına uygulanır.
transformers>=5.10.0 ; sys_platform != 'darwin'
transformers>=5.4,<5.9 ; sys_platform == 'darwin'
