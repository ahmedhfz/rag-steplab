# RAG StepLab environment template
#
# Browser-visible (Next.js). Only this public URL may use NEXT_PUBLIC_.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# FastAPI server-side runtime only. Keep these out of the browser bundle.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=
WRITE_ENABLED=true
MAX_FILE_SIZE_BYTES=52428800
MAX_CONCURRENT_PIPELINE_RUNS=1

# Modal async parse dispatch. Shared production-like local persistence requires
# an authenticated Modal CLI profile; production receives platform identity inside the Modal API container.
MODAL_DISPATCH_ENABLED=true
# Development without shared Supabase persistence uses the same real Docling
# worker path in-process; set false only when local has shared production-like DB/Storage.
LOCAL_PARSE_WORKER_ENABLED=true
MODAL_APP_NAME=rag-steplab-api
MODAL_PARSE_FUNCTION_NAME=parse_worker
MODAL_DOCLING_VOLUME_NAME=rag-steplab-docling-models-v2
DOCLING_PARSER_VERSION=docling-2.117.0
# Worker deploy sets the versioned artifact path; leave empty for local defaults.
DOCLING_ARTIFACTS_PATH=

# Supabase server-side connection and Storage.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=rag-documents
DATABASE_URL=
DATABASE_SCHEMA=rag_lab

# Gemini server-side configuration. Model names stay configurable and must be
# verified against the current Google AI documentation before deployment.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_GENERATION_MODEL=gemini-flash-lite-latest
GEMINI_RERANK_MODEL=gemini-flash-lite-latest
GEMINI_JUDGE_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2

# Playwright E2E. Credentials are server/CI-only and must never use NEXT_PUBLIC_.
E2E_BASE_URL=http://localhost:3000
E2E_API_BASE_URL=http://127.0.0.1:8000
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Protected Vercel Preview için server/CI-only automation bypass secret.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Required only by server-side user provisioning and namespaced full-RAG cleanup.
# Never expose this value to the browser or a NEXT_PUBLIC_ variable.
E2E_SUPABASE_SECRET_KEY=
