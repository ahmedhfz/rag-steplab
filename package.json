{
  "name": "rag-steplab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "next dev",
    "build": "next build",
    "e2e:smoke": "playwright test --project=chromium-seeded",
    "e2e:critical": "playwright test --project=chromium-seeded --grep \"@critical|resets its lineage and Journey state\"",
    "e2e:auth": "playwright test --project=auth",
    "e2e:full": "playwright test --project=full-rag --workers=1",
    "e2e:visual:production": "playwright test --project=production-visual",
    "e2e:headed": "playwright test --project=chromium-seeded --headed",
    "e2e:report": "playwright show-report output/playwright/report",
    "e2e:fixture": "node scripts/e2e.mjs fixture",
    "e2e:bootstrap": "node scripts/e2e.mjs bootstrap",
    "e2e:user": "node scripts/e2e.mjs ensure-user",
    "e2e:cleanup": "node scripts/e2e.mjs cleanup",
    "lint": "eslint .",
    "python:lock": "node .github/scripts/python-locks.mjs",
    "perf:summary": "node scripts/measure-phase6a.mjs",
    "perf:summary:fixture": "python scripts/measure-phase6a-fixture.py",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@number-flow/react": "0.6.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iconoir-react": "7.12.1",
    "next": "16.4.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
