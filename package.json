{
  "name": "rag-steplab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "next dev",
    "build": "next build",
    "e2e": "playwright test --project=chromium-seeded",
    "e2e:smoke": "playwright test --project=chromium-seeded && npm run e2e:visual",
    "e2e:visual": "playwright test --config=e2e/visual/playwright.config.ts",
    "e2e:auth": "playwright test --project=auth",
    "e2e:full": "playwright test --project=full-rag --workers=1",
    "e2e:visual:production": "playwright test --project=figma-production",
    "e2e:visual:canonical": "playwright test --project=figma-canonical",
    "e2e:headed": "playwright test --project=chromium-seeded --headed",
    "e2e:report": "playwright show-report output/playwright/report",
    "e2e:fixture": "node scripts/e2e.mjs fixture",
    "e2e:bootstrap": "node scripts/e2e.mjs bootstrap",
    "e2e:user": "node scripts/e2e.mjs ensure-user",
    "e2e:cleanup": "node scripts/e2e.mjs cleanup",
    "lint": "eslint .",
    "perf:phase6a": "node scripts/measure-phase6a.mjs",
    "perf:phase6a:fixture": "python scripts/measure-phase6a-fixture.py",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.31.0",
    "motion": "^13.1.0",
    "next": "16.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
